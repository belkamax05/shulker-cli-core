#!/usr/bin/env zsh
CURRENT_SHELL=$(getent passwd "$USER" | awk -F: '{print $7}')

if [[ "$CURRENT_SHELL" == *"zsh" ]]; then
    echo "Default shell is already zsh ($CURRENT_SHELL) — no change needed."
else
    echo "Default shell is $CURRENT_SHELL — switching to zsh..."
    chsh -s "$(which zsh)"
fi
